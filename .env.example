PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Keep this server-only. Required for contact messages, applications, and signed upload URLs.
SUPABASE_SERVICE_ROLE_KEY=

# Required only for running npm run supabase:setup.
# Copy the Session pooler connection string from Supabase Dashboard > Connect.
SUPABASE_DB_URL=

# Optional; defaults to "resumes" to match the Lovable Supabase backend.
SUPABASE_RESUME_BUCKET=resumes

# Required only for running npm run supabase:setup.
ADMIN_EMAIL=p.polley@deutsche-pflegeentwicklung.de
ADMIN_PASSWORD=
