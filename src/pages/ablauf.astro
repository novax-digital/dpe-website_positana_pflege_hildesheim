---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import AblaufPublicPage from "@/components/public-pages/AblaufPublicPage";
import { absoluteUrl, careProcessJsonLd } from "@/lib/seo";

const canonicalUrl = absoluteUrl("/ablauf");
---

<BaseLayout
  title="Pflegeberatung & Ablauf in Hildesheim"
  description="In drei einfachen Schritten zur persönlichen Pflege und Betreuung in Hildesheim: kostenlose Beratung, individuelles Angebot und Start der Versorgung."
  jsonLd={careProcessJsonLd(canonicalUrl)}
>
  <AblaufPublicPage currentPath={Astro.url.pathname} client:idle />
</BaseLayout>
