---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
import Kontakt from "@/react-pages/Kontakt";
---

<BaseLayout
  title="Kontakt & Pflegeberatung in Hildesheim"
  description="Kontaktieren Sie Positana Pflege in Hildesheim. Kostenlose Beratung unter 0176 19312010 oder per Kontaktformular."
  schemaType="ContactPage"
