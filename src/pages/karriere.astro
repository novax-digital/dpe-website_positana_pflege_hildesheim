---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
import Karriere from "@/react-pages/Karriere";
import { getPublishedJobListings } from "@/lib/supabase.server";
import { jobPostingJsonLd } from "@/lib/seo";

const jobs = await getPublishedJobListings();
const jobJsonLd = jobs.map((job) => jobPostingJsonLd(job));
Astro.response.headers.set("Cache-Control", "public, s-maxage=900, stale-while-revalidate=86400");
---

<BaseLayout
  title="Pflegejobs in Hildesheim"
  description="Pflegejobs bei Positana Pflege Hildesheim. Bewerben Sie sich als Pflegefachkraft, Pflegehilfskraft oder Alltagsbegleiter:in - flexible Arbeitszeiten, faire Vergütung."
  jsonLd={jobJsonLd}
>
  <PublicLayout currentPath={Astro.url.pathname}>
    <Karriere jobs={jobs} client:idle />
  </PublicLayout>
</BaseLayout>
