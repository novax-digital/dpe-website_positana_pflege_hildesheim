---
import "@/styles/global.css";
import {
  GEO,
  ROUTE_LABELS,
  SITE_LANGUAGE,
  SITE_LOCALE,
  SITE_NAME,
  SITE_SHORT_NAME,
  SITE_URL,
  absoluteUrl,
  normalizePath,
  organizationJsonLd,
  websiteJsonLd,
} from "@/lib/seo";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  schemaType?: string;
  authorName?: string;
  noindex?: boolean;
  publishedAt?: string;
  updatedAt?: string;
  breadcrumbLabel?: string;
  jsonLd?: unknown | unknown[];
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt = "Positana Pflege Hildesheim - fürsorgliche Begleitung im Alltag",
  type = "website",
  schemaType = "WebPage",
  authorName = SITE_SHORT_NAME,
  noindex = false,
  publishedAt,
  updatedAt,
  breadcrumbLabel,
  jsonLd,
} = Astro.props;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const canonicalPath = normalizePath(Astro.url.pathname);
const canonicalUrl = absoluteUrl(canonical ?? canonicalPath);
const socialImageUrl = absoluteUrl(image ?? "/og-image.jpg");
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbJsonLd =
  pathSegments.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "@id": `${canonicalUrl}#breadcrumb`,
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Startseite",
            item: absoluteUrl("/"),
          },
          ...pathSegments.map((segment, index) => {
            const route = `/${pathSegments.slice(0, index + 1).join("/")}`;
            const isLast = index === pathSegments.length - 1;
            return {
              "@type": "ListItem",
              position: index + 2,
              name: isLast && breadcrumbLabel ? breadcrumbLabel : ROUTE_LABELS[segment] ?? segment,
              item: absoluteUrl(route),
            };
          }),
        ],
      }
    : null;
const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType,
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: fullTitle,
  headline: title,
  description,
  inLanguage: SITE_LANGUAGE,
  isPartOf: {
    "@id": `${SITE_URL}/#website`,
  },
  about: {
    "@id": `${SITE_URL}/#organization`,
  },
  provider: {
    "@id": `${SITE_URL}/#organization`,
  },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: socialImageUrl,
    caption: imageAlt,
  },
  ...(breadcrumbJsonLd
    ? {
        breadcrumb: {
          "@id": `${canonicalUrl}#breadcrumb`,
        },
      }
    : {}),
  ...(publishedAt ? { datePublished: publishedAt } : {}),
  ...(updatedAt ? { dateModified: updatedAt } : {}),
};
const jsonLdItems = [
  organizationJsonLd(socialImageUrl),
  websiteJsonLd,
  webPageJsonLd,
  ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []),
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
const serializeJsonLd = (item: unknown) => JSON.stringify(item).replace(/</g, "\\u003c");
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const googlebotContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";
---

<!doctype html>
<html lang={SITE_LANGUAGE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#00667a" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="language" content={SITE_LANGUAGE} />
    <meta name="geo.region" content={GEO.region} />
    <meta name="geo.placename" content={GEO.placename} />
    <meta name="geo.position" content={GEO.position} />
    <meta name="ICBM" content={GEO.position.replace(";", ", ")} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={authorName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={googlebotContent} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" href={canonicalUrl} hreflang="de-DE" />
    <link rel="alternate" href={canonicalUrl} hreflang="x-default" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:site_name" content={SITE_SHORT_NAME} />
    {updatedAt && <meta property="og:updated_time" content={updatedAt} />}
    {type === "article" && authorName && <meta property="article:author" content={authorName} />}
    {type === "article" && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {type === "article" && updatedAt && <meta property="article:modified_time" content={updatedAt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLdItems.map((item) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(item)} />)}
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        const prefetched = new Set();

        const getPrefetchUrl = (anchor) => {
          const href = anchor?.getAttribute("href");
          if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:")) {
            return null;
          }

          if (anchor.target === "_blank" || anchor.dataset.prefetch === "false") {
            return null;
          }

          const url = new URL(href, window.location.href);
          if (url.origin !== window.location.origin) {
            return null;
          }

          if (url.pathname.startsWith("/admin") || url.pathname.startsWith("/api")) {
            return null;
          }

          url.hash = "";
          return url.href;
        };

        const prefetch = (anchor) => {
          const href = getPrefetchUrl(anchor);
          if (!href || prefetched.has(href)) {
            return;
          }

          prefetched.add(href);
          const link = document.createElement("link");
          link.rel = "prefetch";
          link.as = "document";
          link.href = href;
          document.head.appendChild(link);
        };

        const handleLinkIntent = (event) => {
          const target = event.target;
          if (!(target instanceof Element)) {
            return;
          }

          const anchor = target.closest("a[href]");
          if (anchor) {
            prefetch(anchor);
          }
        };

        document.addEventListener("pointerover", handleLinkIntent, { passive: true });
        document.addEventListener("focusin", handleLinkIntent);
      })();
    </script>
  </body>
</html>
